# systemd unit for the demo on the Spark. Install: see SPARK_SETUP.md.
# Code lives in /opt/eigenreel/app (owned by you, read-only to the service); data in /opt/eigenreel/data (owned by eigenreel).
[Unit]
Description=EigenReel visualization demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eigenreel
Group=eigenreel
WorkingDirectory=/opt/eigenreel/app/demo
EnvironmentFile=/etc/eigenreel-demo.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3

# Hardening: the service can only write to its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/eigenreel/data

[Install]
WantedBy=multi-user.target

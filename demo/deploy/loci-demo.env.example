# Copy to /etc/loci-demo.env (sudo install -m 640 -g loci deploy/loci-demo.env.example /etc/loci-demo.env), then edit.

# Identity comes from `tailscale serve`. Never set AUTH_MODE=dev on the Spark.
AUTH_MODE=tailscale
PORT=3000
DATA_DIR=/opt/loci/data

# Tailscale login names of the admins, comma-separated (see SPARK_SETUP.md step 6 for how to find them).
ADMIN_LOGINS=you@example.com

# Shown in the top bar and browser tab. "Loci" is a placeholder: the name is taken (see NAMES.md).
SITE_NAME=Loci

# Review dry run (optional; see github/README.md). Leave commented out until the practice repos exist.
# REGISTRY_REPO=your-org/registry-practice
# REGISTRY_BRANCH=main
# MODERATION_REPO=your-org/moderation-practice
# Fine-grained token with read-only "Contents" access to registry-practice. Optional: without it the
# demo polls the registry every 5 minutes instead of every minute.
# GITHUB_TOKEN=github_pat_...
